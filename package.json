{
  "name": "design-vault",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:supply-chain": "node .github/scripts/check-pnpm-supply-chain.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "lint:design-md": "node .github/scripts/lint-design-md.mjs",
    "check:release-age": "node .github/scripts/check-lockfile-release-age.mjs",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:typecheck": "tsc -p site",
    "visual:capture": "node .github/scripts/visual-regression.mjs capture",
    "visual:compare": "node .github/scripts/visual-regression.mjs compare"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "odiff-bin": "4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "style-dictionary": "^5.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
