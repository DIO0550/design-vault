{
  "$description": "design-vault の正本。生成物（dist/ と references/tokens.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": { "$value": "#ffffff", "$description": "ページとカードの地" },
      "subtle": { "$value": "#f4f5f7", "$description": "区切りたい領域・入力欄の地" }
    },
    "text": {
      "default": {
        "$value": "#1b1e24",
        "$description": "本文・見出し",
        "$extensions": { "design-vault": { "contrastWith": ["{color.bg.default}", "{color.bg.subtle}"] } }
      },
      "muted": {
        "$value": "#5a6170",
        "$description": "補足・プレースホルダー・無効でない副次情報",
        "$extensions": { "design-vault": { "contrastWith": ["{color.bg.default}", "{color.bg.subtle}"] } }
      }
    },
    "border": {
      "default": { "$value": "#d8dce3", "$description": "区切り線・入力欄の枠" }
    },
    "primary": {
      "default": { "$value": "#2c56c9", "$description": "主要な操作・リンク・フォーカスリング" },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上に載る文字",
        "$extensions": { "design-vault": { "contrastWith": ["{color.primary.default}"] } }
      }
    },
    "danger": {
      "default": { "$value": "#c0262d", "$description": "破壊的な操作・エラー" },
      "on": {
        "$value": "#ffffff",
        "$description": "danger.default の上に載る文字",
        "$extensions": { "design-vault": { "contrastWith": ["{color.danger.default}"] } }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "Hiragino Sans", "Noto Sans JP", "system-ui", "sans-serif"],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": ["JetBrains Mono", "SFMono-Regular", "Menlo", "monospace"],
        "$description": "コード・数値の桁揃え"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "28px", "fontWeight": 700, "lineHeight": 1.3 },
      "$description": "ページの見出し（1 画面に 1 つ）"
    },
    "heading-md": {
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "fontWeight": 700, "lineHeight": 1.4 },
      "$description": "セクションの見出し"
    },
    "body": {
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.7 },
      "$description": "本文の既定"
    },
    "body-sm": {
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.6 },
      "$description": "密度の高い UI（表・サイドバー）"
    },
    "caption": {
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5 },
      "$description": "注記・ラベル。本文には使わない"
    },
    "code": {
      "$value": { "fontFamily": "{font.family.mono}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.6 },
      "$description": "コード・トークン名"
    }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": "4px", "$description": "アイコンと文字の間など、要素内の最小の隙間" },
    "sm": { "$value": "8px", "$description": "関連する要素どうしの間" },
    "md": { "$value": "16px", "$description": "コンポーネントの内側の余白・既定の間隔" },
    "lg": { "$value": "32px", "$description": "セクションどうしの間" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px", "$description": "入力欄・タグなど小さな要素" },
    "md": { "$value": "8px", "$description": "カード・ダイアログ" },
    "full": { "$value": "9999px", "$description": "丸ボタン・アバター・ピル" }
  }
}
