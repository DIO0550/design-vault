{
  "$description": "editorial パターンの正本。読み物・ブログ・ナレッジベース向けの温かみのある紙調パターン。生成物（dist/editorial/ と references/editorial/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#fffdf9",
        "$description": "パネルとカードの地"
      },
      "subtle": {
        "$value": "#f6f2ea",
        "$description": "入力欄・小さな操作部品の地"
      },
      "canvas": {
        "$value": "#efeae0",
        "$description": "作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#ebe5d9",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#241f1a",
        "$description": "ツールチップなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#241f1a",
        "$description": "本文・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#62584e",
        "$description": "ラベル・補足など副次的な文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#7d7267",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#968a7e",
        "$description": "アイコン・開閉の印・寸法表示など補助的な表示。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#bfb5a8",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#fffdf9",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#dfd8cc",
        "$description": "パネル境界・入力欄の枠"
      },
      "subtle": {
        "$value": "#ede8de",
        "$description": "セクションの区切り線"
      },
      "strong": {
        "$value": "#bfb5a6",
        "$description": "チェックボックス・フレームなど輪郭を立たせたい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#9a3412",
        "$description": "選択・アクティブ状態・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#fef1e6",
        "$description": "選択中の行の地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上の文字やアイコン",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.primary.default}"
            ]
          }
        }
      }
    },
    "component": {
      "default": {
        "$value": "#6d4c9e",
        "$description": "コンポーネント・インスタンスを示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#b82e2e",
        "$description": "エラー・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#fbeaea",
        "$description": "エラー表示の枠・地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#2b6e44",
        "$description": "成功・正常の表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#e8f3ec",
        "$description": "成功表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Hiragino Sans",
          "Noto Sans JP",
          "system-ui",
          "sans-serif"
        ],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "コード・数値・トークン名"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "30px",
        "fontWeight": 700,
        "lineHeight": 1.25
      },
      "$description": "記事・ページの見出し（1 画面に 1 つ）"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "21px",
        "fontWeight": 700,
        "lineHeight": 1.4
      },
      "$description": "章・セクションの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "13px",
        "fontWeight": 600,
        "lineHeight": 1.5
      },
      "$description": "カテゴリ・フォームラベル"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "18px",
        "fontWeight": 400,
        "lineHeight": 1.8
      },
      "$description": "リード文・導入段落"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.8
      },
      "$description": "長文を読みやすくする本文の既定"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.65
      },
      "$description": "注釈・サイド情報・表"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "図表キャプション・日付"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "$description": "コードスニペット・トークン名"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "密着させたい隙間"
    },
    "xs": {
      "$value": "6px",
      "$description": "要素内の小さな隙間"
    },
    "sm": {
      "$value": "12px",
      "$description": "段落や関連する要素どうしの間"
    },
    "md": {
      "$value": "20px",
      "$description": "カードの内側の余白・既定の間隔"
    },
    "lg": {
      "$value": "40px",
      "$description": "章・セクションどうしの広い余白"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "2px",
      "$description": "タグなど小さな要素"
    },
    "md": {
      "$value": "6px",
      "$description": "入力欄・ボタン"
    },
    "lg": {
      "$value": "10px",
      "$description": "カード・引用枠・ダイアログ"
    },
    "full": {
      "$value": "9999px",
      "$description": "アバター・ピル"
    }
  }
}
