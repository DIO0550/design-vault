{
  "$description": "composer パターンの正本。密度の高いデスクトップツール向けパターン。生成物（dist/composer/ と references/composer/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#ffffff",
        "$description": "パネルとカードの地"
      },
      "subtle": {
        "$value": "#fafafa",
        "$description": "入力欄・小さな操作部品の地"
      },
      "canvas": {
        "$value": "#f5f5f5",
        "$description": "作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#f0f0f0",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#1e1e1e",
        "$description": "ツールチップなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#1e1e1e",
        "$description": "本文・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#767676",
        "$description": "ラベル・補足など副次的な文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#8c8c8c",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#b3b3b3",
        "$description": "アイコン・開閉の印・寸法表示など補助的な表示。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#c4c4c4",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#ffffff",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#e6e6e6",
        "$description": "パネル境界・入力欄の枠"
      },
      "subtle": {
        "$value": "#f0f0f0",
        "$description": "セクションの区切り線"
      },
      "strong": {
        "$value": "#d4d4d4",
        "$description": "チェックボックス・フレームなど輪郭を立たせたい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#0d99ff",
        "$description": "選択・アクティブ状態・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#e5f4ff",
        "$description": "選択中の行の地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上の文字やアイコン"
      }
    },
    "component": {
      "default": {
        "$value": "#9747ff",
        "$description": "コンポーネント・インスタンスを示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#d13438",
        "$description": "エラー・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#f0c8c8",
        "$description": "エラー表示の枠・地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#2f7d3f",
        "$description": "成功・正常の表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#ecf7ee",
        "$description": "成功表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "IBM Plex Sans",
          "Hiragino Sans",
          "Noto Sans JP",
          "system-ui",
          "sans-serif"
        ],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "コード・数値・トークン名"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "18px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "ダイアログ・空状態の見出し"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "13px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "パネルの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "プロパティ群の見出し・強調したい行"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "メニュー項目・やや大きく読ませたい文"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 400,
        "lineHeight": 1.4
      },
      "$description": "UI の既定の文字（行・入力値・ボタン）"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "10px",
        "fontWeight": 400,
        "lineHeight": 1.4
      },
      "$description": "補足・寸法・バッジ"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "9px",
        "fontWeight": 500,
        "lineHeight": 1.3
      },
      "$description": "レールのラベルなど最小の文字。文章には使わない"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "11px",
        "fontWeight": 400,
        "lineHeight": 1.4
      },
      "$description": "トークン名・数値・コード"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "アイコンと印の間など、密着させたい隙間"
    },
    "xs": {
      "$value": "4px",
      "$description": "要素内の小さな隙間"
    },
    "sm": {
      "$value": "8px",
      "$description": "関連する要素どうしの間・行内の間隔"
    },
    "md": {
      "$value": "14px",
      "$description": "パネルの左右の余白・既定の間隔"
    },
    "lg": {
      "$value": "24px",
      "$description": "セクションどうしの間"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "3px",
      "$description": "バッジ・小さな印"
    },
    "md": {
      "$value": "5px",
      "$description": "入力欄・ボタン・行の選択枠"
    },
    "lg": {
      "$value": "6px",
      "$description": "メニュー・ポップオーバー・カード"
    },
    "full": {
      "$value": "9999px",
      "$description": "丸いボタン・ドット・ピル"
    }
  }
}
