{
  "$description": "board パターンの正本。カンバンボードや IDE シェルを備えたタスク管理アプリ向けのクールスレート＆インディゴ調ライトパターン。生成物（dist/board/ と references/board/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#ffffff",
        "$description": "カード・パネル・モーダルの地"
      },
      "subtle": {
        "$value": "#f6f7fa",
        "$description": "サイドバー・入力欄・補助ボタンの地"
      },
      "canvas": {
        "$value": "#f3f5f8",
        "$description": "ボード作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#eceff5",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#1f2328",
        "$description": "ツールチップなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#1f2328",
        "$description": "本文・タスク名・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#59626e",
        "$description": "ラベル・件数・補足情報",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#757f8c",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#8a94a2",
        "$description": "アイコン・開閉の印・補助メタなど。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#adb5c0",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#ffffff",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#e3e5eb",
        "$description": "カード境界・ペイン区切り・入力欄の枠"
      },
      "subtle": {
        "$value": "#eef0f4",
        "$description": "セクションやリスト行の淡い区切り線"
      },
      "strong": {
        "$value": "#d4d7df",
        "$description": "ホバー時・チェックボックス・強調したい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#466abf",
        "$description": "選択・アクティブ状態・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#e9f0ff",
        "$description": "選択中の行・アクティブ項目の地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上の文字やアイコン",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.primary.default}"
            ]
          }
        }
      }
    },
    "component": {
      "default": {
        "$value": "#7c3aed",
        "$description": "コンポーネント・カテゴリ・親要素を示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#b32228",
        "$description": "エラー・期限超過・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.danger.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#ffe8e5",
        "$description": "エラー・期限超過バッジの枠・地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#156f3c",
        "$description": "完了・同期正常・オープンの状態表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#dff5e7",
        "$description": "完了・正常表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Noto Sans JP",
          "Hiragino Sans",
          "system-ui",
          "sans-serif"
        ],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "タスク ID・ファイルパス・コード"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "22px",
        "fontWeight": 700,
        "lineHeight": 1.3
      },
      "$description": "画面・詳細ビューの見出し"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "15px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "カラム・パネル・ダイアログの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "サイドバーのグループ見出し・フォームラベル"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "15px",
        "fontWeight": 400,
        "lineHeight": 1.55
      },
      "$description": "詳細画面の本文・やや大きく読ませたい説明"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "UI の既定の文字（カード・ツリー・ボタン・入力値）"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.45
      },
      "$description": "バッジ・メタ情報・コンパクトな一覧行"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 500,
        "lineHeight": 1.35
      },
      "$description": "件数カウント・キーボードヒント・補助注記"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "タスク ID・ファイルパス・フロントマター"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "アイコンと印の間など密着させたい隙間"
    },
    "xs": {
      "$value": "4px",
      "$description": "バッジ内や行内の最小の隙間"
    },
    "sm": {
      "$value": "8px",
      "$description": "カード内やボタン列など関連要素どうしの間"
    },
    "md": {
      "$value": "12px",
      "$description": "パネル・カードの内側の余白・既定の間隔"
    },
    "lg": {
      "$value": "24px",
      "$description": "セクション・カラム群どうしの間"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px",
      "$description": "ラベル・ステータスバッジ・小さなアイコンボタン"
    },
    "md": {
      "$value": "6px",
      "$description": "ボタン・入力欄・タブ・選択行"
    },
    "lg": {
      "$value": "10px",
      "$description": "カード・パネル・モーダル"
    },
    "full": {
      "$value": "9999px",
      "$description": "同期ピル・アバター・ステータスドット"
    }
  }
}
