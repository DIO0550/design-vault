{
  "$description": "swiss パターンの正本。無彩色と極細罫線だけで構成するストイックなモノクロームパターン。生成物（dist/swiss/ と references/swiss/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#ffffff",
        "$description": "パネルとカードの地"
      },
      "subtle": {
        "$value": "#f7f7f7",
        "$description": "入力欄・小さな操作部品の地"
      },
      "canvas": {
        "$value": "#f0f0f0",
        "$description": "作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#eaeaea",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#111111",
        "$description": "ツールチップなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#111111",
        "$description": "本文・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#595959",
        "$description": "ラベル・補足など副次的な文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#757575",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#8f8f8f",
        "$description": "アイコン・開閉の印・寸法表示など補助的な表示。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#bdbdbd",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#ffffff",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#d9d9d9",
        "$description": "パネル境界・入力欄の枠"
      },
      "subtle": {
        "$value": "#ebebeb",
        "$description": "セクションの区切り線"
      },
      "strong": {
        "$value": "#111111",
        "$description": "チェックボックス・フレームなど輪郭を立たせたい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#111111",
        "$description": "選択・アクティブ状態・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#ededed",
        "$description": "選択中の行の地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上の文字やアイコン",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.primary.default}"
            ]
          }
        }
      }
    },
    "component": {
      "default": {
        "$value": "#404040",
        "$description": "コンポーネント・インスタンスを示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#c81e1e",
        "$description": "エラー・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#fde8e8",
        "$description": "エラー表示の枠・地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#166534",
        "$description": "成功・正常の表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#e8f5ec",
        "$description": "成功表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Helvetica Neue",
          "Hiragino Sans",
          "Noto Sans JP",
          "sans-serif"
        ],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "コード・数値・トークン名"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "26px",
        "fontWeight": 600,
        "lineHeight": 1.25
      },
      "$description": "ページの見出し（1 画面に 1 つ）"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "18px",
        "fontWeight": 600,
        "lineHeight": 1.35
      },
      "$description": "セクションの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "フォームのラベル・見出し補助"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "$description": "リード文"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "$description": "UI と本文の既定"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "表・メタ情報・バッジ"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 500,
        "lineHeight": 1.4
      },
      "$description": "注記・インデックス番号"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "コード・数値・トークン名"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "密着させたい隙間"
    },
    "xs": {
      "$value": "4px",
      "$description": "要素内の最小の隙間"
    },
    "sm": {
      "$value": "8px",
      "$description": "関連する要素どうしの間"
    },
    "md": {
      "$value": "16px",
      "$description": "グリッドとカードの内側余白"
    },
    "lg": {
      "$value": "32px",
      "$description": "セクションどうしの間"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "2px",
      "$description": "タグ・小さな要素"
    },
    "md": {
      "$value": "4px",
      "$description": "入力欄・ボタン"
    },
    "lg": {
      "$value": "6px",
      "$description": "カード・ダイアログ"
    },
    "full": {
      "$value": "9999px",
      "$description": "丸ボタン・ピル"
    }
  }
}
