{
  "$description": "forest パターンの正本。目の疲れを抑えたセージグリーン基調の長時間作業向けパターン。生成物（dist/forest/ と references/forest/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#fbfcfa",
        "$description": "パネルとカードの地"
      },
      "subtle": {
        "$value": "#f1f4ef",
        "$description": "入力欄・小さな操作部品の地"
      },
      "canvas": {
        "$value": "#e8ede6",
        "$description": "作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#e1e8de",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#1b2620",
        "$description": "ツールチップなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#1b2620",
        "$description": "本文・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#4f6056",
        "$description": "ラベル・補足など副次的な文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#6c7f74",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#7e9186",
        "$description": "アイコン・開閉の印・寸法表示など補助的な表示。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#b1bfb7",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#fbfcfa",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#d2dcd5",
        "$description": "パネル境界・入力欄の枠"
      },
      "subtle": {
        "$value": "#e4ebe6",
        "$description": "セクションの区切り線"
      },
      "strong": {
        "$value": "#a7b8ad",
        "$description": "チェックボックス・フレームなど輪郭を立たせたい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#1e6046",
        "$description": "選択・アクティブ状態・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#e3f1ea",
        "$description": "選択中の行の地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上の文字やアイコン",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.primary.default}"
            ]
          }
        }
      }
    },
    "component": {
      "default": {
        "$value": "#7c3aed",
        "$description": "コンポーネント・インスタンスを示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#b91c1c",
        "$description": "エラー・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#fbe9e9",
        "$description": "エラー表示の枠・地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#166534",
        "$description": "成功・正常の表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#e4f4ea",
        "$description": "成功表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Hiragino Sans",
          "Noto Sans JP",
          "system-ui",
          "sans-serif"
        ],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "コード・数値・トークン名"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "26px",
        "fontWeight": 700,
        "lineHeight": 1.3
      },
      "$description": "ページの見出し（1 画面に 1 つ）"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "19px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "セクションの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "13px",
        "fontWeight": 600,
        "lineHeight": 1.5
      },
      "$description": "フォームのラベル・強調したい行"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "17px",
        "fontWeight": 400,
        "lineHeight": 1.75
      },
      "$description": "リード文"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "15px",
        "fontWeight": 400,
        "lineHeight": 1.7
      },
      "$description": "本文の既定"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "$description": "補足・サイドバー・バッジ"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "注記。本文には使わない"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "13.5px",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "$description": "コード・トークン名"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "密着させたい隙間"
    },
    "xs": {
      "$value": "4px",
      "$description": "要素内の最小の隙間"
    },
    "sm": {
      "$value": "8px",
      "$description": "関連する要素どうしの間"
    },
    "md": {
      "$value": "16px",
      "$description": "コンポーネントの内側の余白"
    },
    "lg": {
      "$value": "32px",
      "$description": "セクションどうしの間"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px",
      "$description": "タグ・小さな要素"
    },
    "md": {
      "$value": "8px",
      "$description": "入力欄・ボタン・カード"
    },
    "lg": {
      "$value": "12px",
      "$description": "ダイアログ・大きなカード"
    },
    "full": {
      "$value": "9999px",
      "$description": "丸ボタン・ピル"
    }
  }
}
