{
  "$description": "stone パターンの正本。ドキュメント閲覧と差分レビュー向けの温かみあるストーン調ライトパターン。生成物（dist/stone/ と references/stone/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#ffffff",
        "$description": "本文閲覧ペイン・パネル・カードの地"
      },
      "subtle": {
        "$value": "#fafaf9",
        "$description": "サイドバー・入力欄・補助コントロールの地"
      },
      "canvas": {
        "$value": "#f3f2ef",
        "$description": "作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#efede9",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#1c1917",
        "$description": "ツールチップ・コードブロックなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#1c1917",
        "$description": "本文・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#57534e",
        "$description": "ラベル・メタ情報・補足文",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#78716c",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#8c857d",
        "$description": "アイコン・開閉の印・パス区切りなど補助的な表示。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#b5afa8",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#ffffff",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#e7e5e4",
        "$description": "ペイン境界・入力欄・カードの枠"
      },
      "subtle": {
        "$value": "#f0eeeb",
        "$description": "セクションやコメント間の区切り線"
      },
      "strong": {
        "$value": "#d6d3d1",
        "$description": "セカンダリボタン・フレームなど輪郭を立たせたい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#2563eb",
        "$description": "選択・アクティブタブ・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#eff6ff",
        "$description": "選択中の行やハイライトの地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上の文字やアイコン",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.primary.default}"
            ]
          }
        }
      }
    },
    "component": {
      "default": {
        "$value": "#725aa8",
        "$description": "コンポーネント・注釈・特殊種別を示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#b91c1c",
        "$description": "エラー・削除・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.danger.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#fee2e2",
        "$description": "エラー表示・削除行の枠・地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#15803d",
        "$description": "成功・追加・解決済みの表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#dcfce7",
        "$description": "成功・追加表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "system-ui",
          "-apple-system",
          "Hiragino Sans",
          "Noto Sans JP",
          "Segoe UI",
          "sans-serif"
        ],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "コード・差分・ファイルパス"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "24px",
        "fontWeight": 700,
        "lineHeight": 1.3
      },
      "$description": "文書タイトル・空状態の見出し"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "ペイン・セクションの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "ツリー見出し・ツールバーのラベル・強調したい行"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.65
      },
      "$description": "Markdown 本文など長文の閲覧テキスト"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "UI の既定の文字（ナビゲーション・入力値・ボタン・コメント）"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.45
      },
      "$description": "メタ情報・バッジ・補助説明"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 500,
        "lineHeight": 1.35
      },
      "$description": "パスバー・タイムスタンプなど最小の注記。本文には使わない"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "コード・差分行・ファイルパス"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "アイコンと印の間など密着させたい隙間"
    },
    "xs": {
      "$value": "4px",
      "$description": "要素内の小さな隙間"
    },
    "sm": {
      "$value": "8px",
      "$description": "関連する要素どうしの間・リスト行内の間隔"
    },
    "md": {
      "$value": "14px",
      "$description": "ペインやカードの内側の余白・既定の間隔"
    },
    "lg": {
      "$value": "24px",
      "$description": "セクションどうしの間"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px",
      "$description": "タグ・バッジ・小さな印"
    },
    "md": {
      "$value": "7px",
      "$description": "入力欄・ボタン・タブ・選択行"
    },
    "lg": {
      "$value": "10px",
      "$description": "ポップオーバー・ダイアログ・カード"
    },
    "full": {
      "$value": "9999px",
      "$description": "丸ボタン・ピル・ステータスドット"
    }
  }
}
