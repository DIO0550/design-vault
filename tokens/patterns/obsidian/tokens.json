{
  "$description": "obsidian パターンの正本。開発者コンソールやダークモードアプリ向けの高コントラストな暗色パターン。生成物（dist/obsidian/ と references/obsidian/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#16181d",
        "$description": "パネルとカードの地"
      },
      "subtle": {
        "$value": "#1e2128",
        "$description": "入力欄・小さな操作部品の地"
      },
      "canvas": {
        "$value": "#0f1115",
        "$description": "作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#262a33",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#f3f4f6",
        "$description": "ツールチップなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#eef0f4",
        "$description": "本文・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#9aa1b0",
        "$description": "ラベル・補足など副次的な文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#7d8594",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#6b7280",
        "$description": "アイコン・開閉の印・寸法表示など補助的な表示。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#4b515e",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#111318",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#2b303b",
        "$description": "パネル境界・入力欄の枠"
      },
      "subtle": {
        "$value": "#222630",
        "$description": "セクションの区切り線"
      },
      "strong": {
        "$value": "#3e4554",
        "$description": "チェックボックス・フレームなど輪郭を立たせたい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#2563eb",
        "$description": "選択・アクティブ状態・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#172642",
        "$description": "選択中の行の地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上の文字やアイコン",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.primary.default}"
            ]
          }
        }
      }
    },
    "component": {
      "default": {
        "$value": "#a78bfa",
        "$description": "コンポーネント・インスタンスを示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#f87171",
        "$description": "エラー・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#361c20",
        "$description": "エラー表示の枠・地"
      },
      "on": {
        "$value": "#16181d",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#4ade80",
        "$description": "成功・正常の表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#162e22",
        "$description": "成功表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Hiragino Sans",
          "Noto Sans JP",
          "system-ui",
          "sans-serif"
        ],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "コード・数値・トークン名"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "24px",
        "fontWeight": 600,
        "lineHeight": 1.3
      },
      "$description": "ページの見出し（1 画面に 1 つ）"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "セクション・パネルの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "フォームのラベル・強調したい行"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "$description": "リード文・やや大きく読ませたい説明"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.55
      },
      "$description": "UI と本文の既定"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "テーブル・バッジ・メタ情報"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 500,
        "lineHeight": 1.4
      },
      "$description": "注記・ショートカット表記"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "コード・コマンド・ログ"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "密着させたい隙間"
    },
    "xs": {
      "$value": "4px",
      "$description": "要素内の最小の隙間"
    },
    "sm": {
      "$value": "8px",
      "$description": "関連する要素どうしの間"
    },
    "md": {
      "$value": "16px",
      "$description": "パネル・カードの内側の余白"
    },
    "lg": {
      "$value": "28px",
      "$description": "セクションどうしの間"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px",
      "$description": "タグ・バッジ"
    },
    "md": {
      "$value": "6px",
      "$description": "入力欄・ボタン・選択行"
    },
    "lg": {
      "$value": "10px",
      "$description": "パネル・ダイアログ・カード"
    },
    "full": {
      "$value": "9999px",
      "$description": "丸ボタン・アバター・ピル"
    }
  }
}
