{
  "$description": "basic パターンの正本。特定のプロダクトに寄せない汎用の仮パターン。生成物（dist/basic/ と references/basic/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#ffffff",
        "$description": "パネルとカードの地"
      },
      "subtle": {
        "$value": "#f4f5f7",
        "$description": "入力欄・小さな操作部品の地"
      },
      "canvas": {
        "$value": "#eef0f3",
        "$description": "作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#eceef2",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#1b1e24",
        "$description": "ツールチップなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#1b1e24",
        "$description": "本文・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#5a6170",
        "$description": "ラベル・補足など副次的な文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#6b7280",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#8a909c",
        "$description": "アイコン・開閉の印・寸法表示など補助的な表示。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#b4b9c2",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#ffffff",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#d8dce3",
        "$description": "パネル境界・入力欄の枠"
      },
      "subtle": {
        "$value": "#e9ebef",
        "$description": "セクションの区切り線"
      },
      "strong": {
        "$value": "#b9bfc9",
        "$description": "チェックボックス・フレームなど輪郭を立たせたい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#2c56c9",
        "$description": "選択・アクティブ状態・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#e8eefb",
        "$description": "選択中の行の地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "primary.default の上の文字やアイコン",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.primary.default}"
            ]
          }
        }
      }
    },
    "component": {
      "default": {
        "$value": "#7a3fd1",
        "$description": "コンポーネント・インスタンスを示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#c0262d",
        "$description": "エラー・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#fbe9ea",
        "$description": "エラー表示の枠・地"
      },
      "on": {
        "$value": "#ffffff",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#1f7a3a",
        "$description": "成功・正常の表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#e7f5ec",
        "$description": "成功表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Hiragino Sans",
          "Noto Sans JP",
          "system-ui",
          "sans-serif"
        ],
        "$description": "UI と本文"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "コード・数値・トークン名"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "28px",
        "fontWeight": 700,
        "lineHeight": 1.3
      },
      "$description": "ページの見出し（1 画面に 1 つ）"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "20px",
        "fontWeight": 700,
        "lineHeight": 1.4
      },
      "$description": "セクションの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 600,
        "lineHeight": 1.5
      },
      "$description": "フォームのラベル・強調したい行"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "18px",
        "fontWeight": 400,
        "lineHeight": 1.7
      },
      "$description": "リード文"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "16px",
        "fontWeight": 400,
        "lineHeight": 1.7
      },
      "$description": "本文の既定"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "$description": "密度の高い UI（表・サイドバー）"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "12px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "注記。本文には使わない"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.6
      },
      "$description": "コード・トークン名"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "密着させたい隙間"
    },
    "xs": {
      "$value": "4px",
      "$description": "アイコンと文字の間など、要素内の最小の隙間"
    },
    "sm": {
      "$value": "8px",
      "$description": "関連する要素どうしの間"
    },
    "md": {
      "$value": "16px",
      "$description": "コンポーネントの内側の余白・既定の間隔"
    },
    "lg": {
      "$value": "32px",
      "$description": "セクションどうしの間"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px",
      "$description": "タグなど小さな要素"
    },
    "md": {
      "$value": "8px",
      "$description": "入力欄・ボタン・カード"
    },
    "lg": {
      "$value": "12px",
      "$description": "ダイアログ・大きなカード"
    },
    "full": {
      "$value": "9999px",
      "$description": "丸ボタン・アバター・ピル"
    }
  }
}
