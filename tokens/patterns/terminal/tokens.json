{
  "$description": "terminal パターンの正本。監視パネル・CLI ツール向けのアンバー発光ダークパターン。生成物（dist/terminal/ と references/terminal/DESIGN.md）はここから作り、手で書き換えない。",
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "#141413",
        "$description": "パネルとカードの地"
      },
      "subtle": {
        "$value": "#1d1c1a",
        "$description": "入力欄・小さな操作部品の地"
      },
      "canvas": {
        "$value": "#0c0c0b",
        "$description": "作業領域・ウィンドウの背景"
      },
      "hover": {
        "$value": "#262521",
        "$description": "行やボタンにポインタが乗ったときの地"
      },
      "inverse": {
        "$value": "#f3f1ea",
        "$description": "ツールチップなど反転した面の地"
      }
    },
    "text": {
      "default": {
        "$value": "#f3f1ea",
        "$description": "本文・見出し・値",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}",
              "{color.bg.hover}",
              "{color.primary.subtle}"
            ]
          }
        }
      },
      "muted": {
        "$value": "#a19c8e",
        "$description": "ラベル・補足など副次的な文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}",
              "{color.bg.subtle}"
            ]
          }
        }
      },
      "placeholder": {
        "$value": "#7d796d",
        "$description": "プレースホルダー・空状態の案内"
      },
      "subtle": {
        "$value": "#706c61",
        "$description": "アイコン・開閉の印・寸法表示など補助的な表示。読ませる文章には使わない"
      },
      "disabled": {
        "$value": "#4a4840",
        "$description": "無効な操作・ショートカット表記・区切り記号"
      },
      "inverse": {
        "$value": "#141413",
        "$description": "bg.inverse の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.inverse}"
            ]
          }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#2e2c26",
        "$description": "パネル境界・入力欄の枠"
      },
      "subtle": {
        "$value": "#22211c",
        "$description": "セクションの区切り線"
      },
      "strong": {
        "$value": "#4a473e",
        "$description": "チェックボックス・フレームなど輪郭を立たせたい枠"
      }
    },
    "primary": {
      "default": {
        "$value": "#f59e0b",
        "$description": "選択・アクティブ状態・フォーカスリング・主要な操作"
      },
      "subtle": {
        "$value": "#332610",
        "$description": "選択中の行の地"
      },
      "on": {
        "$value": "#141413",
        "$description": "primary.default の上の文字やアイコン",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.primary.default}"
            ]
          }
        }
      }
    },
    "component": {
      "default": {
        "$value": "#c084fc",
        "$description": "コンポーネント・インスタンスを示す色（アイコン・名前・枠）"
      }
    },
    "danger": {
      "default": {
        "$value": "#f87171",
        "$description": "エラー・破壊的な操作",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.bg.default}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#361818",
        "$description": "エラー表示の枠・地"
      },
      "on": {
        "$value": "#141413",
        "$description": "danger.default の上の文字",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.danger.default}"
            ]
          }
        }
      }
    },
    "success": {
      "default": {
        "$value": "#4ade80",
        "$description": "成功・正常の表示",
        "$extensions": {
          "design-vault": {
            "contrastWith": [
              "{color.success.subtle}"
            ]
          }
        }
      },
      "subtle": {
        "$value": "#132d1c",
        "$description": "成功表示の地"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "JetBrains Mono",
          "IBM Plex Mono",
          "Hiragino Sans",
          "Noto Sans JP",
          "monospace"
        ],
        "$description": "UI と本文（等幅主体）"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "ログ・数値・コマンド"
      }
    }
  },
  "typography": {
    "$type": "typography",
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "22px",
        "fontWeight": 700,
        "lineHeight": 1.3
      },
      "$description": "画面タイトル"
    },
    "heading-md": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "15px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "パネル・セクションの見出し"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 600,
        "lineHeight": 1.4
      },
      "$description": "フィールドラベル・メトリクス名"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "14px",
        "fontWeight": 400,
        "lineHeight": 1.55
      },
      "$description": "説明文・やや大きな表示"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "UI とログの既定"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "11px",
        "fontWeight": 400,
        "lineHeight": 1.45
      },
      "$description": "ステータスバッジ・タイムスタンプ"
    },
    "caption": {
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "10px",
        "fontWeight": 500,
        "lineHeight": 1.35
      },
      "$description": "最小の注記・キーバインド表記"
    },
    "code": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "13px",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "コマンド・ログ出力"
    }
  },
  "space": {
    "$type": "dimension",
    "2xs": {
      "$value": "2px",
      "$description": "密着させたい隙間"
    },
    "xs": {
      "$value": "4px",
      "$description": "要素内の最小の隙間"
    },
    "sm": {
      "$value": "8px",
      "$description": "関連する要素どうしの間"
    },
    "md": {
      "$value": "14px",
      "$description": "パネル内余白・既定の間隔"
    },
    "lg": {
      "$value": "24px",
      "$description": "セクションどうしの間"
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "2px",
      "$description": "バッジ・ステータス印"
    },
    "md": {
      "$value": "4px",
      "$description": "入力欄・ボタン"
    },
    "lg": {
      "$value": "6px",
      "$description": "パネル・ダイアログ"
    },
    "full": {
      "$value": "9999px",
      "$description": "インジケータドット・ピル"
    }
  }
}
